  m_Script: {fileID: 11500000, guid: 68a3deb273964e84dada6dc648fdb09a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogo
  panelDialogo: {fileID: 1925604266}
  textoDialogo: {fileID: 1545174314}
  lineas:
  - "Arturo, ya conseguiste la primera parte de la cura\u2026 pero esto apenas comienza."
  - "La segunda est\xE1 escondida en esta ciudad. Ser\xE1 mucho m\xE1s dif\xEDcil
    que la primera vez, as\xED que mantente alerta."
  - "Como ocurri\xF3 antes, no podr\xE1s salir de aqu\xED hasta encontrar la siguiente
    parte de la cura."
  - Encontraras a alguien quien te guiara y te dara una pista de donde encontraras
    la puerta y la siguiente parte de la cura.
  velocidadTexto: 0.03
