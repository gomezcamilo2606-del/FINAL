    - target: {fileID: 6397438140356022322, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: panelDialogo
      value: 
      objectReference: {fileID: 1925604266}
    - target: {fileID: 6397438140356022322, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: textoDialogo
      value: 
      objectReference: {fileID: 1545174314}
    - target: {fileID: 6397438140356022322, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: 'lineas.Array.data[0]'
      value: "Arturo, ya conseguiste la primera parte de la cura\u2026 pero esto
        apenas comienza."
      objectReference: {fileID: 0}
    - target: {fileID: 6397438140356022322, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: 'lineas.Array.data[1]'
      value: "La segunda est\xE1 escondida en esta ciudad. Ser\xE1 mucho m\xE1s dif\xEDcil
        que la primera vez, as\xED que mantente alerta."
      objectReference: {fileID: 0}
    - target: {fileID: 6397438140356022322, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: 'lineas.Array.data[2]'
      value: "Como ocurri\xF3 antes, no podr\xE1s salir de aqu\xED hasta encontrar
        la siguiente parte de la cura."
      objectReference: {fileID: 0}
    - target: {fileID: 6397438140356022322, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: 'lineas.Array.data[3]'
      value: " Observa los carteles y presta atenci\xF3n a las luces\u2026 te mostrar\xE1n
        el camino"
      objectReference: {fileID: 0}
    - target: {fileID: 8130461529367440879, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
      propertyPath: m_Name
      value: npc
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 2b3786f4ba309864aafc9c48e4aff469, type: 3}
