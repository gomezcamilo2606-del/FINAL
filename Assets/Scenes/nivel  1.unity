MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 217744170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 68a3deb273964e84dada6dc648fdb09a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogo
  panelDialogo: {fileID: 943348657}
  textoDialogo: {fileID: 625044214}
  lineas:
  - "Arturo... eres la \xFAnica persona que no se ha convertido completamente en
    planta. A\xFAn conservas tu conciencia, y eso significa que todav\xEDa hay esperanza.\n"
  - "Te acompa\xF1ar\xE9 a lo largo de esta aventura, porque debemos viajar por distintas
    ciudades para reunir las partes de la cura antes de que sea demasiado tarde.\n"
  - "La primera parte se encuentra en este bosque, y no podr\xE1s abandonarlo sin
    conseguirla. Este lugar es peligroso, as\xED que mantente alerta.\n\n"
  - "Gu\xEDate por los carteles del camino. Al final encontrar\xE1s una puerta que
    te llevar\xE1 a tu siguiente destino. Buena suerte, Arturo.\n"
  velocidadTexto: 0.03
