      value: 
      objectReference: {fileID: 1166692261}
    - target: {fileID: 8104767098466440805, guid: 52d4634abc8652040a4c54a40c01d8dc, type: 3}
      propertyPath: textoDialogo
      value: 
      objectReference: {fileID: 253782252}
    - target: {fileID: 8104767098466440805, guid: 52d4634abc8652040a4c54a40c01d8dc, type: 3}
      propertyPath: 'lineas.Array.data[0]'
      value: "Has llegado lejos... aqu\xED encontrar\xE1s a alguien que podr\xE1
        ayudarte, como ocurri\xF3 antes."
      objectReference: {fileID: 0}
    - target: {fileID: 8104767098466440805, guid: 52d4634abc8652040a4c54a40c01d8dc, type: 3}
      propertyPath: 'lineas.Array.data[1]'
      value: "En este laboratorio se encuentra la \xFAltima parte de la cura, pero
        conseguirla no ser\xE1 sencillo."
      objectReference: {fileID: 0}
    - target: {fileID: 8104767098466440805, guid: 52d4634abc8652040a4c54a40c01d8dc, type: 3}
      propertyPath: 'lineas.Array.data[2]'
      value: "Cuando la tengas, deber\xE1s salir del laboratorio por la puerta principal
        para poder consumirla con seguridad"
      objectReference: {fileID: 0}
    - target: {fileID: 8104767098466440805, guid: 52d4634abc8652040a4c54a40c01d8dc, type: 3}
      propertyPath: 'lineas.Array.data[3]'
      value: "Mantente alerta... lo que viene ser\xE1 mucho m\xE1s complicado que
        todo lo que has enfrentado hasta ahora."
      objectReference: {fileID: 0}
